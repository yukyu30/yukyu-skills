{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "yukyu-skills",
  "description": "yukyu30 の Claude Code skills",
  "owner": { "name": "yukyu30" },
  "plugins": [
    {
      "name": "blog-writing",
      "source": "./plugins/blog-writing",
      "description": "日本語の技術ブログを書く・レビューするためのスキル集",
      "version": "0.1.0",
      "category": "writing"
    },
    {
      "name": "furigana-code",
      "source": "./plugins/furigana-code",
      "description": "コードの各行にふりがなのような注釈を添えて読み解くスキル",
      "version": "0.1.0",
      "category": "development"
    },
    {
      "name": "i-have-adhd",
      "source": { "source": "github", "repo": "ayghri/i-have-adhd" },
      "description": "ADHD の読み手向けに、次の行動を先頭に置いて手順を番号で示す出力に整える（外部参照）",
      "category": "productivity"
    },
    {
      "name": "stop-ai-slop-jp",
      "source": { "source": "github", "repo": "iKora128/stop-ai-slop-jp" },
      "description": "AIで書いた日本語を人間が書いた文章に戻すスキル（外部参照）",
      "strict": false,
      "skills": ["./"],
      "category": "writing"
    },
    {
      "name": "pstack",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/cursor/plugins.git",
        "path": "pstack"
      },
      "description": "Cursor 製の agent workflow 集 pstack（外部参照）",
      "strict": false,
      "skills": "./skills/",
      "agents": ["./agents/comment-sicko.md", "./agents/poteto-agent.md"],
      "category": "development"
    }
  ]
}
